# Public URL (used for sitemap, canonical links, Open Graph)
SITE_URL=https://cyberpoint.az

# Test/staging copies: set to 1 so search engines don't index them
# NOINDEX=1

# First admin account (used only when the database is created)
ADMIN_EMAIL=admin@cyberpoint.az
ADMIN_PASSWORD=change-me-to-a-long-password

# 32+ random characters; signs admin sessions. Generate: openssl rand -hex 32
SESSION_SECRET=

# Email delivery for contact / career forms
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0            # 1 for port 465
SMTP_USER=no-reply@cyberpoint.az
SMTP_PASS=
MAIL_FROM="Cyberpoint website <no-reply@cyberpoint.az>"
MAIL_TO=info@cyberpoint.az

# Where data lives (database, uploads, CVs). Docker uses /app/data.
# DATA_DIR=./data

# AI assistant (Claude). Without a key the widget runs in basic mode (navigation + prepared answers).
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ASSISTANT_MODEL=claude-opus-5-5
